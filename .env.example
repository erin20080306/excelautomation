NODE_ENV=development
DATABASE_URL=postgresql://excelmaster:excelmaster@localhost:5432/excelmaster?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-64-hex-characters
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
PARSER_URL=http://localhost:8000
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_FILE_SIZE_MB=50
MAX_ZIP_UNCOMPRESSED_MB=500
PGMQ_VISIBILITY_TIMEOUT_SECONDS=1800
PGMQ_POLL_INTERVAL_MS=1000
PGMQ_RETRY_BASE_SECONDS=2
WORKER_CONCURRENCY=3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=測試管理者
SEED_WORKSPACE_NAME=ExcelMaster 測試工作區
ALLOW_PRODUCTION_SEED=false
