{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/worker/Dockerfile",
    "watchPatterns": [
      "apps/worker/**",
      "apps/api/prisma/**",
      "packages/shared/**",
      "package.json",
      "package-lock.json",
      "tsconfig.base.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": "300"
  }
}
