{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "python -m pip install -r requirements.txt",
  "buildCommand": "python -m compileall app",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,__pycache__/**,**/*.pyc}"
    }
  }
}
