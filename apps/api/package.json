    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/sensible": "6.0.2",
    "@prisma/client": "6.2.1",
    "bcryptjs": "2.4.3",
    "fastify": "5.10.0",
    "fastify-plugin": "5.0.1",
    "file-type": "22.0.1",
    "jsonwebtoken": "9.0.2",
    "mime-types": "2.1.35",
    "nanoid": "5.0.9",
    "prisma": "6.2.1",
    "unzipper": "0.12.3",
    "zod": "3.24.1"
